{
  "name": "@droptime/roast-console",
  "version": "0.1.0",
  "private": true,
  "description": "Shared roast console core: live chart, console components, curve math, simulator engine. Consumed by droptime-logger (Tauri/Vite), droptime-web (demo), droptime-app (companion viewer).",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
